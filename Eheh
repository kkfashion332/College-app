                <small style="display:block; color:var(--ink-soft); font-size:13px; font-weight:700;">{{ settings.get('upi_id', 'No UPI set') }}</small>
            </div>
        </div>
        {% endif %}
        
        {% if settings.get('flipkart_qr_url') %}
        <div class="row" style="flex:1; border:none;">
            <img src="{{ settings.get('flipkart_qr_url') }}" alt="Flipkart QR" style="width:80px; height:80px; border-radius:10px; object-fit:cover; flex:0 0 auto; border:2px solid #0284c7;">
            <div style="flex:1; min-width:0;">
                <b style="display:block; font-size:14px; color:#0284c7;">Flipkart QR Code</b>
                <small style="display:block; color:var(--ink-soft); font-size:13px; font-weight:700;">{{ settings.get('flipkart_upi_id', 'No UPI set') }}</small>
            </div>
        </div>
        {% endif %}
    </div>
  </div>
  {% endif %}

</div>
<footer>MZ Fashion Admin &middot; no login &middot; {{ now }}</footer>
</body>
</html>
"""

TABS = [
    ("orders", "Orders"),
    ("products", "Products"),
    ("categories", "Categories"),
    ("banners", "Banners"),
    ("settings", "Settings"),
]

PLACEHOLDER = "https://placehold.co/120x120/eee/999?text=No+Image"

# ----------------------------------------------------------------------------
# ROUTES
# ----------------------------------------------------------------------------
@app.route("/")
def index():
    tab = request.args.get("tab", "orders")
    if tab not in dict(TABS):
        tab = "orders"

    orders = as_list("orders", sort_desc=True)
    products = as_list("products")
    categories = as_list("categories")
    banners = as_list("banners")

    try:
        settings = ref("settings/payment").get() or {}
    except Exception:
        settings = {}
    if not isinstance(settings, dict):
        settings = {}

    for o in orders:
        o["_price"] = money(o.get("price"))
        
        items_val = o.get("items")
        if isinstance(items_val, dict):
            parsed_items = []
            for k, v in items_val.items():
                if isinstance(v, dict):
                    parsed_items.append(v)
            o["items"] = parsed_items
        elif not isinstance(items_val, list):
            o["items"] = None

    for p in products:
        p["_price"] = money(p.get("price"))
        p["_mrp"] = money(p.get("mrp")) if num(p.get("mrp")) else ""

    revenue = money(sum(num(o.get("price")) for o in orders))

    edit_key = request.args.get("edit")
    edit_product = None
    if edit_key:
        for p in products:
            if p["key"] == edit_key:
                edit_product = p
                break

    return render_template_string(
        TEMPLATE,
        tab=tab,
        tabs=TABS,
        orders=orders,
        products=products,
        categories=categories,
        banners=banners,
        settings=settings,
        revenue=revenue,
        edit_product=edit_product,
        placeholder=PLACEHOLDER,
        db_url=DB_URL,
        fb_error=FIREBASE_ERROR,
        now=datetime.now().strftime("%d %b %Y, %I:%M %p"),
    )

@app.route("/product/save", methods=["POST"])
def save_product():
    f = request.form
    name = (f.get("name") or "").strip()
    if not name:
        flash("Product ka naam zaroori hai.", "error")
        return redirect(url_for("index", tab="products"))

    price = num(f.get("price"))
    mrp = num(f.get("mrp"))
    discount = ""
    if mrp > price > 0:
        discount = "%d%%" % round((mrp - price) * 100.0 / mrp)

    data = {
        "name": name,
        "price": price,
        "mrp": mrp,
        "discount": discount,
        "category": (f.get("category") or "").strip(),
        "img": (f.get("img") or "").strip(),
        "shirtSizes": (f.get("shirtSizes") or "").strip(),
        "jeansSizes": (f.get("jeansSizes") or "").strip(),
        "colorNames": (f.get("colorNames") or "").strip(),
        "colorSizes": (f.get("colorSizes") or "").strip(),
        "colorJeansSizes": (f.get("colorJeansSizes") or "").strip(), # New field mapping added
        "colorImages": (f.get("colorImages") or "").strip(),
        "isFlipkart": "true" if f.get("isFlipkart") else "false",
    }

    key = (f.get("key") or "").strip()
    try:
        if key:
            ref("products/%s" % key).update(data)
            flash("Product update ho gaya.", "ok")
        else:
            new_ref = ref("products").push(data)
            new_ref.update({"id": new_ref.key})
            flash("Product add ho gaya.", "ok")
    except Exception as e:
        flash("Save fail: %s" % e, "error")

    return redirect(url_for("index", tab="products"))

@app.route("/category/add", methods=["POST"])
def add_category():
    name = (request.form.get("name") or "").strip()
    img = (request.form.get("img") or "").strip()
    if not name:
        flash("Category ka naam zaroori hai.", "error")
        return redirect(url_for("index", tab="categories"))
    try:
        new_ref = ref("categories").push({"name": name, "img": img})
        new_ref.update({"id": new_ref.key})
        flash("Category add ho gayi.", "ok")
    except Exception as e:
        flash("Category add fail: %s" % e, "error")
    return redirect(url_for("index", tab="categories"))

@app.route("/banner/add", methods=["POST"])
def add_banner():
    raw = request.form.get("img") or ""
    target = (request.form.get("target_link") or "").strip()

    urls = []
    for chunk in raw.replace(",", "\n").splitlines():
        u = chunk.strip()
        if u:
            urls.append(u)

    if not urls:
        flash("Kam se kam ek image URL daalein.", "error")
        return redirect(url_for("index", tab="banners"))

    added = 0
    try:
        for u in urls:
            new_ref = ref("banners").push({"img": u, "target_link": target})
            new_ref.update({"id": new_ref.key})
            added += 1
        flash("%d banner add ho gaye." % added, "ok")
    except Exception as e:
        flash("Banner add fail (%d added): %s" % (added, e), "error")
    return redirect(url_for("index", tab="banners"))

