# ----------------------------------------------------------------------------
# FIREBASE INIT
# ----------------------------------------------------------------------------
FIREBASE_ERROR = None

def init_firebase():
    global FIREBASE_ERROR
    try:
        if not firebase_admin._apps:
            if not os.path.exists(CRED_PATH):
                raise FileNotFoundError(
                    "serviceAccountKey.json nahi mila: %s" % CRED_PATH
                )
            cred = credentials.Certificate(CRED_PATH)
            firebase_admin.initialize_app(cred, {"databaseURL": DB_URL})
        FIREBASE_ERROR = None
        return True
    except Exception as e:
        FIREBASE_ERROR = "%s: %s" % (type(e).__name__, e)
        traceback.print_exc()
        return False

init_firebase()

def ref(path):
    if not firebase_admin._apps:
        if not init_firebase():
            raise RuntimeError(FIREBASE_ERROR or "Firebase init failed")
    return db.reference(path)

def as_list(node_path, sort_desc=False):
    """RTDB dict ko list of dicts (key ke saath) me badalta hai."""
    try:
        data = ref(node_path).get() or {}
    except Exception as e:
        print("READ ERROR", node_path, e)
        return []
    if isinstance(data, list):
        data = {str(i): v for i, v in enumerate(data) if v}
    items = []
    for k, v in data.items():
        if not isinstance(v, dict):
            continue
        row = dict(v)
        row["key"] = k
        items.append(row)
    items.sort(key=lambda r: str(r.get("key", "")), reverse=sort_desc)
    return items

def num(value, default=0):
    try:
        return float(str(value).replace(",", "").strip())
    except Exception:
        return default

def money(value):
    n = num(value)
    if n == int(n):
        return str(int(n))
    return "%.2f" % n

