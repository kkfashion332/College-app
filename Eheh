# ==========================================
# ROUTES
# ==========================================

@app.route('/')
def dashboard():
    if not session.get('logged_in'):
        return '''
        <body style="background:#121212; color:#d4af37; font-family:sans-serif; text-align:center; padding-top:100px;">
            <h2>MZ FASHION ADMIN</h2>
            <form action="/login" method="POST" style="margin-top:30px;">
                <input type="text" name="user" placeholder="Username" style="padding:10px; margin-bottom:10px;"><br>
                <input type="password" name="pass" placeholder="Password" style="padding:10px; margin-bottom:10px;"><br>
                <button type="submit" style="padding:10px 30px; background:#d4af37; color:#000; font-weight:bold; border:none; cursor:pointer;">LOGIN</button>
            </form>
        </body>
        '''
    
    # Fetch Data from Firebase
    orders = db.reference('orders').get() or {}
    products = db.reference('products').get() or {}
    categories = db.reference('categories').get() or {}
    banners = db.reference('banners').get() or {}
    settings = db.reference('settings/payment').get() or {}
    
    # Sort orders newest first
    orders = dict(sorted(orders.items(), key=lambda item: item[0], reverse=True))

    return render_template_string(ADMIN_HTML, orders=orders, products=products, categories=categories, banners=banners, settings=settings)

@app.route('/login', methods=['POST'])
def login():
    if request.form['user'] == ADMIN_USER and request.form['pass'] == ADMIN_PASS:
        session['logged_in'] = True
    return redirect('/')

@app.route('/logout')
def logout():
    session.clear()
    return redirect('/')

# --- ACTIONS ---

@app.route('/update_settings', methods=['POST'])
def update_settings():
    db.reference('settings/payment').set({
        'qr_url': request.form['qr_url'],
        'upi_id': request.form['upi_id'],
        'whatsapp': request.form['whatsapp']
    })
    flash("Settings updated successfully!")
    return redirect('/')

@app.route('/add_product', methods=['POST'])
def add_product():
    new_ref = db.reference('products').push()
    new_ref.set({
        'id': new_ref.key,
        'name': request.form['name'],
        'price': int(request.form['price']),
        'mrp': int(request.form['mrp']),
        'discount': request.form['discount'],
        'category': request.form['category'],
        'img': request.form['img'],
        'shirtSizes': request.form['shirtSizes'],
        'jeansSizes': request.form['jeansSizes']
    })
    flash("Product added successfully!")
    return redirect('/')

@app.route('/edit_product', methods=['POST'])
def edit_product():
    prod_id = request.form['id']
    db.reference(f'products/{prod_id}').update({
        'name': request.form['name'],
        'price': int(request.form['price']),
        'mrp': int(request.form['mrp']),
        'discount': request.form['discount'],
        'category': request.form['category'],
        'img': request.form['img'],
        'shirtSizes': request.form['shirtSizes'],
        'jeansSizes': request.form['jeansSizes']
    })
    flash("Product updated successfully!")
    return redirect('/')

@app.route('/delete_product')
def delete_product():
    db.reference(f"products/{request.args.get('id')}").delete()
    flash("Product deleted!")
    return redirect('/')

@app.route('/add_category', methods=['POST'])
def add_category():
    new_ref = db.reference('categories').push()
    new_ref.set({'id': new_ref.key, 'name': request.form['name'], 'img': request.form['img']})
    flash("Category added!")
    return redirect('/')

@app.route('/delete_category', methods=['POST'])
def delete_category():
    db.reference(f"categories/{request.form['id']}").delete()
    flash("Category deleted!")
    return redirect('/')

@app.route('/add_banner', methods=['POST'])
def add_banner():
    new_ref = db.reference('banners').push()
    new_ref.set({'id': new_ref.key, 'img': request.form['img'], 'target_link': request.form['target_link']})
    flash("Banner added!")
    return redirect('/')

@app.route('/delete_banner', methods=['POST'])
def delete_banner():
    db.reference(f"banners/{request.form['id']}").delete()
    flash("Banner deleted!")
    return redirect('/')

@app.route('/delete_order', methods=['POST'])
def delete_order():
    db.reference(f"orders/{request.form['id']}").delete()
    flash("Order deleted!")
    return redirect('/')

if __name__ == '__main__':
    app.run(debug=True)
