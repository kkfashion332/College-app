@app.route("/order/status", methods=["POST"])
def update_order_status():
    key = request.form.get("key")
    status = request.form.get("status")
    tracking_id = (request.form.get("tracking_id") or "").strip()
    tracking_link = (request.form.get("tracking_link") or "").strip()
    
    if not key or not status:
        flash("Galat request aayi hai.", "error")
        return redirect(url_for("index", tab="orders"))
        
    update_data = {"status": status}
    if status == "Confirmed":
        update_data["tracking_id"] = tracking_id
        update_data["tracking_link"] = tracking_link
        
    try:
        ref("orders/%s" % key).update(update_data)
        flash(f"Order status '{status}' kar diya gaya hai.", "ok")
    except Exception as e:
        flash("Status update fail: %s" % e, "error")
    return redirect(url_for("index", tab="orders"))

@app.route("/delete", methods=["POST"])
def delete_item():
    node = request.form.get("node")
    key = (request.form.get("key") or "").strip()
    tab = request.form.get("tab") or "orders"
    if node not in ("orders", "products", "categories", "banners") or not key:
        flash("Galat delete request.", "error")
        return redirect(url_for("index", tab=tab))
    try:
        ref("%s/%s" % (node, key)).delete()
        flash("Delete ho gaya.", "ok")
    except Exception as e:
        flash("Delete fail: %s" % e, "error")
    return redirect(url_for("index", tab=tab))

