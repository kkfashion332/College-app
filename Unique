# TABS DEFINITION
TABS = [
    ("orders", "Orders"),
    ("products", "Products"),
    ("categories", "Categories"),
    ("banners", "Banners"),
    ("users", "Users & MSG"),
    ("settings", "Settings"),
]

PLACEHOLDER = "https://placehold.co/120x120/f9fafb/9ca3af?text=No+Image"

# ----------------------------------------------------------------------------
# ROUTES
# ----------------------------------------------------------------------------
@app.route("/")
def index():
    tab = request.args.get("tab", "orders")
    if tab not in dict(TABS):
        tab = "orders"

    orders = as_list("orders", sort_desc=True)
    products = as_list("products")
    categories = as_list("categories")
    banners = as_list("banners")
    users = as_list("users", sort_desc=True) # Fetched real-time users data

    try:
        settings = ref("settings/payment").get() or {}
    except Exception:
        settings = {}
    if not isinstance(settings, dict):
        settings = {}

    for o in orders:
        o["_price"] = money(o.get("price"))
        
        # --- FIX FOR FIREBASE ARRAY/DICT CONVERSION ISSUE ---
        items_val = o.get("items")
        if isinstance(items_val, dict):
            parsed_items = []
            for k, v in items_val.items():
                if isinstance(v, dict):
                    parsed_items.append(v)
            o["items"] = parsed_items
        elif not isinstance(items_val, list):
            o["items"] = None

    for p in products:
        p["_price"] = money(p.get("price"))
        p["_mrp"] = money(p.get("mrp")) if num(p.get("mrp")) else ""

    revenue = money(sum(num(o.get("price")) for o in orders))

    edit_key = request.args.get("edit")
    edit_product = None
    if edit_key:
        for p in products:
            if p["key"] == edit_key:
                edit_product = p
                break

    return render_template_string(
        TEMPLATE,
        tab=tab,
        tabs=TABS,
        orders=orders,
        products=products,
        categories=categories,
        banners=banners,
        users=users,
        settings=settings,
        revenue=revenue,
        edit_product=edit_product,
        placeholder=PLACEHOLDER,
        db_url=DB_URL,
        fb_error=FIREBASE_ERROR,
        now=datetime.now().strftime("%d %b %Y, %I:%M %p"),
    )

@app.route("/product/save", methods=["POST"])
def save_product():
    f = request.form
    name = (f.get("name") or "").strip()
    if not name:
        flash("Product name is required.", "error")
        return redirect(url_for("index", tab="products"))

    price = num(f.get("price"))
    mrp = num(f.get("mrp"))
    discount = ""
    if mrp > price > 0:
        discount = "%d%% OFF" % round((mrp - price) * 100.0 / mrp)

    data = {
        "name": name,
        "price": price,
        "mrp": mrp,
        "discount": discount,
        "category": (f.get("category") or "").strip(),
        "img": (f.get("img") or "").strip(),
        "shirtSizes": (f.get("shirtSizes") or "").strip(),
        "jeansSizes": (f.get("jeansSizes") or "").strip(),
    }

    key = (f.get("key") or "").strip()
    try:
        if key:
            ref("products/%s" % key).update(data)
            flash("Product successfully updated.", "ok")
        else:
            new_ref = ref("products").push(data)
            new_ref.update({"id": new_ref.key})
            flash("New product added successfully.", "ok")
    except Exception as e:
        flash("Save failed: %s" % e, "error")

    return redirect(url_for("index", tab="products"))

@app.route("/category/add", methods=["POST"])
def add_category():
    name = (request.form.get("name") or "").strip()
    img = (request.form.get("img") or "").strip()
    if not name:
        flash("Category name is required.", "error")
        return redirect(url_for("index", tab="categories"))
    try:
        new_ref = ref("categories").push({"name": name, "img": img})
        new_ref.update({"id": new_ref.key})
        flash("Category added successfully.", "ok")
    except Exception as e:
        flash("Category add failed: %s" % e, "error")
    return redirect(url_for("index", tab="categories"))

@app.route("/banner/add", methods=["POST"])
def add_banner():
    raw = request.form.get("img") or ""
    target = (request.form.get("target_link") or "").strip()

    urls = []
    for chunk in raw.replace(",", "\n").splitlines():
        u = chunk.strip()
        if u:
            urls.append(u)

    if not urls:
        flash("Please enter at least one image URL.", "error")
        return redirect(url_for("index", tab="banners"))

    added = 0
    try:
        for u in urls:
            new_ref = ref("banners").push({"img": u, "target_link": target})
            new_ref.update({"id": new_ref.key})
            added += 1
        flash("%d banner(s) added successfully." % added, "ok")
    except Exception as e:
        flash("Banner add failed (%d added): %s" % (added, e), "error")
    return redirect(url_for("index", tab="banners"))

@app.route("/settings/save", methods=["POST"])
def save_settings():
    data = {
        "upi_id": (request.form.get("upi_id") or "").strip(),
        "qr_url": (request.form.get("qr_url") or "").strip(),
        "whatsapp": (request.form.get("whatsapp") or "").strip(),
    }
    try:
        ref("settings/payment").set(data)
        flash("Settings saved successfully.", "ok")
    except Exception as e:
        flash("Settings save failed: %s" % e, "error")
    return redirect(url_for("index", tab="settings"))

# --- ROUTE: ORDER STATUS UPDATE ---
@app.route("/order/status", methods=["POST"])
def update_order_status():
    key = request.form.get("key")
    status = request.form.get("status")
    if not key or not status:
        flash("Invalid request.", "error")
        return redirect(url_for("index", tab="orders"))
    try:
        ref("orders/%s" % key).update({"status": status})
        flash(f"Order status updated to '{status}'.", "ok")
    except Exception as e:
        flash("Status update failed: %s" % e, "error")
    return redirect(url_for("index", tab="orders"))

@app.route("/delete", methods=["POST"])
def delete_item():
    node = request.form.get("node")
    key = (request.form.get("key") or "").strip()
    tab = request.form.get("tab") or "orders"
    if node not in ("orders", "products", "categories", "banners") or not key:
        flash("Invalid delete request.", "error")
        return redirect(url_for("index", tab=tab))
    try:
        ref("%s/%s" % (node, key)).delete()
        flash("Item deleted successfully.", "ok")
    except Exception as e:
        flash("Delete failed: %s" % e, "error")
    return redirect(url_for("index", tab=tab))

@app.route("/health")
def health():
    try:
        ref("/").get()
        return {"firebase": "ok", "db": DB_URL}
    except Exception as e:
        return {"firebase": "error", "detail": str(e)}, 500

